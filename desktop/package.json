{
  "name": "atelier-home-manager",
  "version": "1.1.1",
  "private": true,
  "description": "Ứng dụng quản lý website, công trình và nhân sự ATELIER HOME",
  "author": "ATELIER HOME",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/infiniti-money/Web-Design.git"
  },
  "scripts": {
    "prepare:ui": "node prepare-ui.cjs",
    "start": "npm run prepare:ui && electron .",
    "test": "node --test test/*.test.cjs",
    "test:smoke": "node test/smoke.cjs",
    "dist:win": "npm run prepare:ui && electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0",
    "dompurify": "3.4.17",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "marked": "18.1.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "home.atelier.manager",
    "productName": "ATELIER HOME Manager",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "security.cjs",
      "updates.cjs",
      "ui/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "ATELIER-HOME-Manager-${version}-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "ATELIER-HOME-Manager-${version}-${arch}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/infiniti-money/Web-Design/releases/download/desktop-stable/",
        "channel": "latest"
      }
    ]
  }
}
